{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esr-next",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esr-next",
      "database_id": "6ba20348-5122-41be-a675-74a6ee21b35c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "EDIT_ALLOWED_EMAILS": "engineering@nswash.com",
    "DELETE_ALLOWED_EMAILS": "engineering@nswash.com"
  }
}
